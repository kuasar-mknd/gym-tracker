{
    "mcpServers": {
        "laravel-boost": {
            "command": "vendor/bin/sail",
            "args": [
                "artisan",
                "boost:mcp"
            ]
        },
        "grepai": {
            "command": "./grepai",
            "args": [
                "mcp-serve"
            ]
        }
    }
}