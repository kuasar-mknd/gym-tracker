includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/shipmonk/dead-code-detector/rules.neon
    - vendor/phpstan/phpstan-strict-rules/rules.neon
    - vendor/phpstan/phpstan-deprecation-rules/rules.neon
    # Les 430 erreurs que l'analyse de tests/ met au jour sont figees ici plutot
    # qu'ignorees : le fichier ne doit que retrecir. Le plus gros poste, 138
    # dereferencements de modele potentiellement nul, fait planter un test au lieu
    # de le faire echouer proprement — voir #1341.
    - phpstan-baseline.neon

parameters:
    paths:
        - app/
        - database/
        - routes/
        - tests/

    # level: max suit automatiquement la derniere version de PHPStan, ce qui est
    # voulu : une montee de version doit remonter ses nouvelles regles, pas les
    # taire. Le baseline absorbe le residuel et ne doit que retrecir.
    level: max
    treatPhpDocTypesAsCertain: false

    # Un appel depuis tests/ ne compte plus comme un usage.
    #
    # Sans ce reglage, le detecteur ne peut pas voir la forme de code mort la
    # plus frequente ici : un symbole abandonne garde ses tests, donc il reste
    # « reference ». CreateGoalAction avait un test unitaire ET un test feature
    # pour zero appelant, et elle a survecu au nettoyage de #1367 pour cette
    # raison exacte ; il a fallu la trouver a la main en #1396.
    #
    # Meme histoire pour deux composants Vue (#1392), les cinq routes web
    # doublees (#1419), et les trois familles de #1421 — toutes trouvees par
    # des analyses manuelles pendant que la CI restait verte.
    shipmonkDeadCode:
        usageExcluders:
            tests:
                enabled: true
                devPaths:
                    - tests/

    ignoreErrors:
        # PHPUnit, Livewire et le Builder Eloquent exposent des methodes statiques
        # appelees dynamiquement ($this->assertX(), $query->where()). C'est
        # l'idiome des frameworks, pas de la dette : 825 des 945 erreurs remontees
        # par strict-rules viennent de la. Vigie porte exactement le meme ignore.
        # La depreciation vient du framework, pas d'ici : Password::default()
        # renvoie un Illuminate\Validation\Rules\Password, qui implemente le Rule
        # deprecie et PAS ValidationRule. Retyper le PHPDoc en ValidationRule est
        # faux — verifie, cela produit 4 erreurs return.type. Rien a corriger tant
        # que Laravel n'a pas migre sa propre classe.
        - identifier: return.deprecatedInterface
          path: app/Actions/Fortify/PasswordValidationRules.php
        # level: max exige que tout appel de methode porte sur un objet connu.
        # Dans les tests, les valeurs viennent de reponses JSON et de datasets :
        # elles sont mixed par nature. Cette famille represente 1543 des 2187
        # erreurs a level max, toutes dans tests/, et aucune ne designe un defaut.
        # property.nonObject n'est PAS ignore. Nuance mesuree en le drainant :
        # tous ne sont pas des modeles nuls. Une partie est du mixed venant des
        # fixtures Pest posees sur $this dans beforeEach — PHPStan resout $this
        # a Pest\PendingCalls\TestCall, donc $this->user est mixed. Les deux
        # familles meritent d'etre vues : la premiere fait planter un test, la
        # seconde masque toute verification de type sur la fixture.
        - identifier: method.nonObject
          path: tests/*
        - identifier: staticMethod.dynamicCall
        - identifier: method.dynamicName
          path: tests/*
        # Les DTO de statistiques sont serialises en JSON vers les props Inertia :
        # leurs proprietes promues sont bien lues, par json_encode et non par du
        # PHP. Le detecteur ne peut pas le voir, et les supprimer casserait les
        # graphiques. Le contrat de cles est couvert par StatsChartPointsContractTest.
        - identifier: shipmonk.deadProperty.neverRead
          path: app/DTOs/*
        # forceDeleteAny / restoreAny / replicate / reorder sont generes par
        # Filament-Shield sur chaque policy. Ils sont inatteignables aujourd'hui
        # (aucune ressource Filament ne les declenche) mais font partie du contrat
        # que Shield regenere : les supprimer les verrait revenir au prochain
        # `shield:generate`.
        # Le motif n'est plus ancre en fin de chaine : depuis l'activation de
        # usageExcluders.tests, le message porte un suffixe explicatif.
        - identifier: shipmonk.deadMethod
          path: app/Policies/*
          message: '#::(forceDeleteAny|restoreAny|replicate|reorder)\b#'
        # Les cas d'enum sont instancies a l'execution par from(), via les casts
        # Eloquent — jamais ecrits en toutes lettres hors des tests. Le detecteur
        # ne peut pas voir cette voie. Ce n'est pas une hypothese : #899 rapporte
        # un `"Abdos" is not a valid backing value` en production, c'est-a-dire
        # exactement ce chemin, sur une valeur absente de l'enum.
        - identifier: shipmonk.deadEnumCase
          path: app/Enums/*
        # toWebPush est appele dynamiquement par WebPushChannel : via() renvoie
        # la classe du canal, et le canal appelle la methode par son nom. Aucun
        # appel statique n'existe donc, et n'a a exister.
        - identifier: shipmonk.deadMethod
          path: app/Notifications/*
          message: '#::toWebPush\b#'
        # N'etre appele que par des tests est le role d'une fabrique. L'excluder
        # les signale par construction ; les supprimer reviendrait a supprimer la
        # raison d'etre du fichier.
        - identifier: shipmonk.deadMethod
          path: database/factories/*
        # Documente en OpenAPI mais jamais route : routes/api.php sert /api/v1/status
        # depuis une closure qui duplique la reponse. Divergence doc/implementation
        # a traiter avec la regeneration de la spec (#1344), pas par une suppression
        # qui retirerait la doc du seul endpoint documente.
        - identifier: shipmonk.deadMethod
          path: app/Http/Controllers/Api/Swagger.php
        # Pest lie $this au TestCase a l'execution, mais l'analyse statique ne voit
        # que le TestCall renvoye par it()/test(). Toute l'API de test ($this->get,
        # actingAs, assertDatabaseHas...) apparait donc comme inexistante. Ce sont
        # des faux positifs de construction, pas de la dette : 1850 erreurs dont
        # l'immense majorite vient de la.
        - identifier: method.notFound
          path: tests/*
          message: '#Pest\\PendingCalls\\TestCall#'
        - identifier: property.notFound
          path: tests/*
          message: '#Pest\\PendingCalls\\TestCall#'
        # Les macros Dusk sont enregistrees dans DuskTestCase::setUp.
        - identifier: method.notFound
          path: tests/Browser/*
          message: '#Laravel\\Dusk\\Browser#'

    excludePaths:

    scanFiles:

