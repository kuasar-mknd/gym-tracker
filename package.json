{
    "$schema": "https://www.schemastore.org/package.json",
    "name": "gym-tracker",
    "private": true,
    "type": "module",
    "engines": {
        "node": ">=24",
        "npm": ">=11"
    },
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "format": "prettier --write \"resources/**/*.{js,vue,css}\" && ./vendor/bin/pint",
        "lint": "npm run lint:js && npm run lint:php",
        "lint:js": "prettier --check \"resources/**/*.{js,vue,css}\" \"tests/js/**/*.js\" && eslint .",
        "lint:php": "./vendor/bin/phpstan analyze --memory-limit=2G",
        "test": "vitest run",
        "test:coverage": "vitest run --coverage",
        "test:js": "vitest run",
        "prepare": "husky"
    },
    "lint-staged": {
        "resources/**/*.{js,vue,css}": "prettier --write",
        "**/*.php": "./vendor/bin/pint"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@inertiajs/vue3": "^3.7.0",
        "@tailwindcss/forms": "^0.5.11",
        "@tailwindcss/vite": "^4.3.3",
        "@vitejs/plugin-vue": "^6.0.8",
        "@vitest/coverage-v8": "^4.1.10",
        "@vue/test-utils": "^2.4.11",
        "autoprefixer": "^10.5.4",
        "axios": "^1.19.0",
        "concurrently": "^10.0.5",
        "eslint": "^10.8.1",
        "eslint-plugin-vue": "^10.10.0",
        "globals": "^17.11.0",
        "husky": "^9.1.7",
        "jsdom": "^30.0.1",
        "laravel-vite-plugin": "^3.2.0",
        "lint-staged": "^17.3.0",
        "postcss": "^8.5.26",
        "prettier": "^3.9.6",
        "prettier-plugin-tailwindcss": "^0.8.1",
        "tailwindcss": "^4.3.3",
        "vite": "^8.2.2",
        "vite-plugin-pwa": "^1.3.0",
        "vitest": "^4.1.11",
        "vue": "^3.5.41",
        "workbox-core": "^7.4.1",
        "workbox-precaching": "^7.4.1"
    },
    "dependencies": {
        "@sentry/vue": "^10.70.0",
        "chart.js": "^4.5.1",
        "dayjs": "^1.11.23",
        "serialize-javascript": "^7.1.0",
        "vue-chartjs": "^5.3.4",
        "ziggy-js": "^2.6.4"
    },
    "overrides": {
        "serialize-javascript": "^7.1.0",
        "brace-expansion": "^5.0.9",
        "nanoid@3": "^3.3.18"
    },
    "optionalDependencies": {
        "@rollup/rollup-linux-arm64-gnu": "^4.62.5"
    }
}
