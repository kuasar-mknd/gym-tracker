{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "format": "prettier --write \"resources/**/*.{js,vue,css}\" && ./vendor/bin/pint",
        "lint": "npm run lint:js && npm run lint:php",
        "lint:js": "prettier --check \"resources/**/*.{js,vue,css}\"",
        "lint:php": "./vendor/bin/phpstan analyze --memory-limit=2G",
        "test": "vitest run",
        "test:js": "vitest run",
        "prepare": "husky"
    },
    "lint-staged": {
        "resources/**/*.{js,vue,css}": "prettier --write",
        "**/*.php": "./vendor/bin/pint"
    },
    "devDependencies": {
        "@inertiajs/vue3": "^3.6.1",
        "@tailwindcss/forms": "^0.5.3",
        "@tailwindcss/vite": "^4.3.3",
        "@vitejs/plugin-vue": "^6.0.8",
        "@vitest/coverage-v8": "^4.1.10",
        "@vue/test-utils": "^2.4.11",
        "autoprefixer": "^10.5.4",
        "axios": "^1.16.0",
        "concurrently": "^10.0.4",
        "husky": "^9.1.7",
        "jsdom": "^30.0.0",
        "laravel-vite-plugin": "^3.1.3",
        "lint-staged": "^17.2.0",
        "postcss": "^8.5.23",
        "prettier": "^3.9.6",
        "prettier-plugin-tailwindcss": "^0.8.1",
        "tailwindcss": "^4.3.3",
        "vite": "^8.0.10",
        "vite-plugin-pwa": "^1.3.0",
        "vitest": "^4.1.10",
        "vue": "^3.5.40",
        "workbox-precaching": "^7.4.0",
        "workbox-routing": "^7.4.0",
        "workbox-strategies": "^7.4.0",
        "workbox-window": "^7.4.0"
    },
    "dependencies": {
        "@sentry/vue": "^10.68.0",
        "chart.js": "^4.5.1",
        "dayjs": "^1.11.21",
        "lucide-vue-next": "^0.577.0",
        "radix-vue": "^1.9.17",
        "serialize-javascript": "^7.0.5",
        "vue-chartjs": "^5.3.4",
        "ziggy-js": "^2.6.3"
    },
    "overrides": {
        "serialize-javascript": "^7.0.5"
    },
    "pnpm": {
        "overrides": {
            "serialize-javascript": "^7.0.5"
        }
    },
    "optionalDependencies": {
        "@rollup/rollup-linux-arm64-gnu": "^4.62.3"
    }
}
