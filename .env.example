APP_NAME=GymTracker
APP_ENV=local
APP_KEY=
APP_DEBUG=true

APP_URL=http://localhost

APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Les services de Sail (compose.yaml). Le service mysql crée la base et
# l'utilisateur au premier démarrage d'un volume vide ; l'image refuse root
# comme utilisateur, et phpunit.xml se connecte en sail/password.
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=gym_tracker
DB_USERNAME=sail
DB_PASSWORD=password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@gymtracker.app"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# Connexion sociale : un bouton n'apparaît qu'avec l'identifiant ET le secret.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI="${APP_URL}/auth/github/callback"

# Apple : le Services ID, puis l'équipe, l'identifiant de la clé et la clé .p8
# en clair (une ligne, « \n » à la place des retours) pour signer le secret à
# chaque échange ; à défaut, un secret déjà signé dans APPLE_CLIENT_SECRET.
# Le rappel arrive en POST et n'aboutit qu'en HTTPS.
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
APPLE_CLIENT_SECRET=
APPLE_REDIRECT_URI="${APP_URL}/auth/apple/callback"

OCTANE_SERVER=frankenphp

# Web Push : des clés VAPID propres à chaque environnement, générées par
# `npx web-push generate-vapid-keys`.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Identité de l'expéditeur auprès du service push : une adresse « mailto: »
# ou une URL. Vide, elle retombe sur APP_URL (web-push refuse un sujet absent).
VAPID_SUBJECT=

# Port de l'hôte publié par Sail
APP_PORT=80

# Dusk
DUSK_DRIVER_URL=http://selenium:4444/wd/hub

# Propres à la production, où elles se posent dans la pile et non dans ce
# fichier : le README (« Variables d'environnement ») dit le rôle de chacune.
# Vides ici, le panneau et Horizon restent ouverts en local.
ADMIN_ALLOWED_IPS=
HORIZON_ALLOWED_EMAILS=
# Pairs dont l'application croit les en-têtes X-Forwarded-* (adresses ou
# sous-réseaux, séparés par des virgules). Vide : la boucle locale et les trois
# plages privées. En production, l'adresse sous laquelle le proxy inverse joint app.
TRUSTED_PROXIES=
# Obligatoire pour `db:seed --class=AdminSeeder` ; jamais réécrit sur un compte existant.
ADMIN_INITIAL_PASSWORD=
# Adresse qui reçoit les contrôles de santé au rouge ; vide = pas de courriel.
HEALTH_TO_ADDRESS=
# Mot de passe AES-256 des archives : sans lui, aucune sauvegarde n'est écrite.
BACKUP_ARCHIVE_PASSWORD=

# En-tête `Server-Timing` : durée de l'application, de ses étapes et des
# requêtes SQL, lisible dans l'onglet réseau du navigateur, pour un utilisateur
# connecté seulement. `true` le temps d'une mesure.
SERVER_TIMING_ENABLED=false
