import { describe, it, expect, vi, beforeEach, afterEach } from 'vitest'
import { flushPromises } from '@vue/test-utils'
import { retirerLesEcouteursDuService, poserLaPage } from '../utils/fileHorsLigne'
import { creerUnFauxServeur, fileDurable, monterLaSeance, routeDeTest, seances } from './seanceHorsLigne'

const reseau = vi.hoisted(() => ({ serveur: null }))
vi.mock('@/Utils/http', () => ({ http: (config) => reseau.serveur.repondre(config) }))
vi.mock('@inertiajs/vue3', () => ({
    router: { post: vi.fn(), patch: vi.fn() },
    useForm: (champs) => ({ ...champs, transform: vi.fn(), patch: vi.fn() }),
    usePage: () => ({ props: {} }),
}))
vi.mock('@/composables/useHaptics', () => ({ triggerHaptic: vi.fn() }))
vi.mock('@formkit/drag-and-drop/vue', () => ({ dragAndDrop: () => {} }))

const seance = () => ({ id: 5, workout_lines: [{ id: 1, exercise_id: 7, exercise: { id: 7, name: 'Squat', type: 'strength' }, recommended_values: null, sets: [{ id: 3, weight: 80, reps: 5, is_completed: true, is_warmup: false }] }] })

beforeEach(() => {
    localStorage.clear()
    reseau.serveur = creerUnFauxServeur({ series: [{ id: 3, workout_line_id: 1, weight: 80, reps: 5, is_completed: true }] })
    globalThis.route = routeDeTest
})
afterEach(async () => {
    await seances.demonterToutes()
    retirerLesEcouteursDuService()
    poserLaPage(null)
})

describe('sonde', () => {
    it('annuler après que le réseau a créé la série décochée', async () => {
        const page = await monterLaSeance(seance())
        reseau.serveur.enLigne = false
        page.addSet(1)
        await flushPromises()
        const serie = page.ligne().sets.at(-1)
        await page.toggleSetCompletion(serie)
        await flushPromises()
        page.retirerAvecDelai(serie.id)
        await flushPromises()
        reseau.serveur.enLigne = true
        await page.sync.processQueue()
        await flushPromises()
        page.annulerLaSuppression()
        await flushPromises()
        await new Promise((r) => setTimeout(r, 50))
        await flushPromises()
        console.log('ECRAN', JSON.stringify(page.ligne().sets.map(({ id, is_completed }) => [id, is_completed])))
        console.log('SERVEUR', JSON.stringify([...reseau.serveur.series.values()].map((s) => [s.id, s.is_completed])))
        console.log('REQUETES', JSON.stringify(reseau.serveur.resume()))
        console.log('FILE', JSON.stringify(fileDurable()))
    })

    it('cache puis revient : une seule suppression', async () => {
        const page = await monterLaSeance(seance())
        page.retirerAvecDelai(3)
        await flushPromises()
        const etat = vi.spyOn(document, 'visibilityState', 'get').mockReturnValue('hidden')
        document.dispatchEvent(new Event('visibilitychange'))
        window.dispatchEvent(new Event('pagehide'))
        etat.mockRestore()
        await flushPromises()
        console.log('FILE2', JSON.stringify(fileDurable().map((e) => e.method + ' ' + e.url)))
        page.annulerLaSuppression()
        await flushPromises()
        console.log('ECRAN2', JSON.stringify(page.ligne().sets.map((s) => s.id)))
        await page.sync.processQueue()
        await flushPromises()
        page.validerLaSuppression()
        await seances.demonterToutes()
        await flushPromises()
        console.log('REQUETES2', JSON.stringify(reseau.serveur.resume()))
    })
})
